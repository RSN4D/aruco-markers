{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "vcpkg-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": {
                    "type": "FILEPATH",
                    "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
                },
                "VCPKG_MANIFEST_MODE": "ON"
            }
        },
        {
            "name": "windows-x64-debug",
            "displayName": "Windows x64 Debug",
            "description": "Windows x64 Debug build with vcpkg",
            "inherits": "vcpkg-base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_GUI_APP": "ON"
            }
        },
        {
            "name": "windows-x64-release",
            "displayName": "Windows x64 Release",
            "description": "Windows x64 Release build with vcpkg",
            "inherits": "vcpkg-base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_GUI_APP": "ON"
            }
        },
        {
            "name": "windows-x64-release-ninja",
            "displayName": "Windows x64 Release (Ninja)",
            "description": "Windows x64 Release build with Ninja and vcpkg",
            "inherits": "vcpkg-base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_GUI_APP": "ON"
            }
        },
        {
            "name": "windows-x64-release-cli-only",
            "displayName": "Windows x64 Release (CLI only)",
            "description": "Windows x64 Release build without GUI (no ImGui dependency)",
            "inherits": "vcpkg-base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_GUI_APP": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-x64-debug",
            "configurePreset": "windows-x64-debug",
            "configuration": "Debug"
        },
        {
            "name": "windows-x64-release",
            "configurePreset": "windows-x64-release",
            "configuration": "Release"
        },
        {
            "name": "windows-x64-release-ninja",
            "configurePreset": "windows-x64-release-ninja"
        },
        {
            "name": "windows-x64-release-cli-only",
            "configurePreset": "windows-x64-release-cli-only",
            "configuration": "Release"
        }
    ]
}
